# Profile values. `hq init` fills TEAM, USER_NAME and ISSUE_EXAMPLE (--team, --user-name, --issue-example, or it asks).
USER_NAME='CHANGEME'      # how the PM refers to you (`hq init` asks; keep the quotes if it has a space)
TEAM=CHANGEME
ISSUE_EXAMPLE=CHANGEME-123
# Models (claude --model alias or ID). Empty = Claude Code default. Per-worker: spawn-worker --model <m>
HQ_PM_MODEL=opus
HQ_WORKER_MODEL=sonnet
