# A remote worker: an external agent (another machine) that hq hands issues to over a signed HTTP request and supervises over ssh.
# Copy to remotes/<name>.env in your PRIVATE profile (name: lowercase letters, digits, dashes). Nothing here is read from the template.
REMOTE_URL=https://remote.example.org/webhooks/pm-task    # POST target (the signed request goes here)
REMOTE_SECRET_FILE=~/.config/hq/remotes/myremote.secret   # shared HMAC secret, mode 600, no trailing newline; never in the repo
REMOTE_SSH=myremote-pm                                    # ssh host or ssh-config alias for read-only status queries
REMOTE_STATUS_CMD='~/bin/pm-status'                       # runs on the remote (no spaces or shell characters); called as "<cmd> status <request-id>" or "<cmd> recent"
REMOTE_LABEL=myremote                                     # the remote's marker in tracker comments, e.g. [MYREMOTE] DONE ...
