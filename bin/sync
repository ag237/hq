#!/usr/bin/env bash
# sync: commit any changes in the private STATE repo (the git repo that contains $STATE and the profiles) and push it
# to its origin. No-op when clean. Never force-pushes. The hq app repo is deliberately never synced from here.
# Exit: 0 ok or nothing to do, 1 setup problem, 2 push/rebase failed (needs a human).
set -uo pipefail
_s="${BASH_SOURCE[0]}"; while [ -L "$_s" ]; do _d="$(cd "$(dirname "$_s")" && pwd)"; _s="$(readlink "$_s")"; case "$_s" in /*) ;; *) _s="$_d/$_s";; esac; done
HQ_DIR="$(cd "$(dirname "$_s")/.." && pwd)"; . "$HQ_DIR/bin/lib.sh"
[ "${HQ_SYNC:-on}" = off ] && { echo "sync: disabled (HQ_SYNC=off)"; exit 0; }
[ -d "$STATE" ] || { echo "sync: state dir $STATE does not exist" >&2; exit 1; }
SYNC_REPO="$(git -C "$STATE" rev-parse --show-toplevel 2>/dev/null)" || { echo "sync: $STATE is not inside a git repo (hq init --state-repo DIR sets one up)" >&2; exit 1; }
if [ "$(cd "$SYNC_REPO" && pwd -P)" = "$(cd "$HQ_DIR" && pwd -P)" ]; then
  echo "sync: state lives inside the hq app repo; refusing to commit it there. Move it to a separate private repo (hq init --state-repo DIR)." >&2; exit 1
fi
cd "$SYNC_REPO" || exit 1
LOCK="$(git rev-parse --absolute-git-dir)/hq-sync.lock.d"   # inside .git so it is never committed; mkdir is an atomic portable lock
if ! mkdir "$LOCK" 2>/dev/null; then
  pid="$(cat "$LOCK/pid" 2>/dev/null || true)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then echo "sync: already running"; exit 0; fi
  rm -rf "$LOCK"; mkdir "$LOCK" 2>/dev/null || { echo "sync: already running"; exit 0; }
fi
echo $$ > "$LOCK/pid"; trap 'rm -rf "$LOCK"' EXIT
git remote get-url origin >/dev/null 2>&1 || { echo "sync: no origin remote" >&2; exit 1; }
branch="$(git branch --show-current)"; [ -n "$branch" ] || { echo "sync: detached HEAD" >&2; exit 1; }

# the check-in heartbeat changes every tick: keep it untracked via the repo-local exclude (never committed, no noise)
_real="$(cd "$SYNC_REPO" && pwd -P)"; _st="$(cd "$STATE" && pwd -P)"; _rel="${_st#"$_real"}"
_ex="$(git rev-parse --git-path info/exclude)"; mkdir -p "$(dirname "$_ex")"
grep -qxF "$_rel/heartbeat" "$_ex" 2>/dev/null || echo "$_rel/heartbeat" >> "$_ex"
if [ -n "$(git status --porcelain)" ]; then
  git add -A
  # never push credentials: scan what is about to be committed (briefs and logs are free text)
  if git diff --cached -U0 --no-color | grep '^+' | grep -v '^+++' | grep -qE -f "$HQ_DIR/secret-patterns.txt"; then
    git reset -q
    echo "sync: refusing to commit: staged changes look like they contain a credential (see $HQ_DIR/secret-patterns.txt). Remove it, then re-run." >&2; exit 1
  fi
  git commit -q -m "hq: auto-sync $(date +%Y-%m-%dT%H:%M:%S%z)" -m "Changed: $(git diff --cached --name-only | head -8 | tr '\n' ' ')" \
    || { echo "sync: commit failed" >&2; exit 1; }
fi

ahead() { git rev-list --count "origin/$branch..HEAD" 2>/dev/null || echo 1; }
tmo 60 git fetch -q origin 2>/dev/null
[ "$(ahead)" != 0 ] || { echo "sync: up to date"; exit 0; }

if tmo 60 git push -q origin "HEAD:$branch" 2>/dev/null; then echo "sync: pushed"; exit 0; fi
# rejected (remote has commits we lack) or network trouble: try one rebase, then push again
if tmo 60 git pull --rebase --autostash -q origin "$branch" 2>/dev/null && tmo 60 git push -q origin "HEAD:$branch" 2>/dev/null; then
  echo "sync: rebased and pushed"; exit 0
fi
git rebase --abort 2>/dev/null
echo "sync: push failed (diverged history, no network or no credentials); local commits are kept, nothing was forced" >&2
sync_check "$SYNC_REPO" || true     # says so when the cause is authentication (it never pushes)
exit 2
