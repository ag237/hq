#!/usr/bin/env bash
# hq [up]                build whatever is missing, then attach (attach only if interactive)
# hq init [opts]        set this machine up (local profile, env, PATH link); see `hq init --help`
# hq doctor              check requirements
# hq config              regenerate ~/home/.claude (agent, commands, settings) from claude/ + the active profile
# hq status              board next to live tmux windows
# hq down                kill the tmux session (state stays on disk; `hq up` resumes active workers)
# hq park <ISSUE>        close a worker's window but keep its session/worktree (not resumed by `hq up`)
# hq revive <ISSUE>      reopen a parked/done worker by EXACT board issue id (resumes its conversation)
# hq find <term>         search board, briefs and old transcripts for a keyword (case-insensitive)
# hq adopt <uuid> <ISSUE> [cwd]   put a pre-existing session on the board as `parked`
# hq autostart on|off|status|show  run `hq up` at login: systemd user unit (Linux/WSL) or launchd agent (macOS); show prints it
set -euo pipefail
_s="${BASH_SOURCE[0]}"; while [ -L "$_s" ]; do _d="$(cd "$(dirname "$_s")" && pwd)"; _s="$(readlink "$_s")"; case "$_s" in /*) ;; *) _s="$_d/$_s";; esac; done
HQ_DIR="$(cd "$(dirname "$_s")/.." && pwd)"; . "$HQ_DIR/bin/lib.sh"

gen_config() { # render claude/ + profile into ~/home/.claude (generated files; edit claude/ or profiles/, not these)
  local d="$HOME_DIR/.claude" f t tmp1 tmp2
  mkdir -p "$d"
  for t in agents commands; do [ -L "$d/$t" ] && rm -f "$d/$t"; mkdir -p "$d/$t"; done
  [ -L "$d/settings.json" ] && rm -f "$d/settings.json"
  { render < "$HQ_DIR/claude/agents/pm.md"; printf '\n'; [ -f "$PROFILE_DIR/pm-profile.md" ] && render < "$PROFILE_DIR/pm-profile.md"; } > "$d/agents/pm.md"
  [ -f "$d/commands/.hq-generated" ] && while read -r f; do rm -f "$d/commands/$f"; done < "$d/commands/.hq-generated"
  : > "$d/commands/.hq-generated"
  for f in "$HQ_DIR"/claude/commands/*.md; do
    render < "$f" > "$d/commands/$(basename "$f")"; basename "$f" >> "$d/commands/.hq-generated"
  done
  tmp1="$(mktemp)"; tmp2="$(mktemp)"
  render < "$HQ_DIR/claude/settings.json" > "$tmp1"
  if [ -f "$PROFILE_DIR/settings.json" ]; then render < "$PROFILE_DIR/settings.json" > "$tmp2"; else echo '{}' > "$tmp2"; fi
  python3 -I - "$tmp1" "$tmp2" "$d/settings.json" <<'PY'
import json, sys
a, b, out = (json.load(open(sys.argv[1])), json.load(open(sys.argv[2])), sys.argv[3])
allow = a.get("permissions", {}).get("allow", [])
for r in b.get("permissions", {}).get("allow", []):
    if r not in allow: allow.append(r)
a.setdefault("permissions", {})["allow"] = allow
json.dump(a, open(out, "w"), indent=2); open(out, "a").write("\n")
PY
  rm -f "$tmp1" "$tmp2"
}

start_pm() {
  local uuid cmd
  if [ -s "$PM_FILE" ] && transcript_exists "$HOME_DIR" "$(cat "$PM_FILE")"; then
    uuid="$(cat "$PM_FILE")"; cmd="claude$(pm_model_flag) --agent pm --resume $uuid"
  else
    uuid="$(new_uuid)"; echo "$uuid" > "$PM_FILE"; cmd="claude$(pm_model_flag) --agent pm --session-id $uuid -n pm"
  fi
  if tm has-session -t "$SESSION" 2>/dev/null; then tm new-window -d -t "$SESSION:" -n pm -c "$HOME_DIR" "$cmd"
  else tm new-session -d -s "$SESSION" -n pm -c "$HOME_DIR" "$cmd"; fi
  echo "hq: started PM ($uuid)"; PM_FRESH=1
}

up() {
  command -v tmux >/dev/null || { echo "tmux not installed" >&2; exit 1; }
  gen_config; PM_FRESH=0
  has_window pm || start_pm
  if [ -s "$BOARD" ]; then
    while IFS=$'\t' read -r issue repo cwd uuid status _; do
      [ -n "${issue:-}" ] || continue
      [ "$status" = active ] || continue          # parked/done are NOT resumed on rebuild
      has_window "$issue" || { start_worker "$issue" "$repo" "$cwd" "$uuid" && echo "hq: resumed worker $issue"; }
    done < "$BOARD"
  fi
  if [ "$PM_FRESH" = 1 ]; then
    # /loop does not survive a restart, so re-arm it once the TUI is up.
    ( sleep "${HQ_PM_BOOT_WAIT:-10}"
      tm send-keys -t "$SESSION:pm" '/standup' Enter; sleep 2
      tm send-keys -t "$SESSION:pm" '/loop /checkin' Enter ) >/dev/null 2>&1 &
  fi
}

doctor_cmd() { # returns 1 if a REQUIRED tool is missing
  local missing=0 t hint
  case "$(uname)" in Darwin) hint="brew install";; *) hint="sudo apt install  # or your distro's package manager";; esac
  for t in bash git tmux python3 claude; do
    if command -v "$t" >/dev/null 2>&1; then printf '  ok       %s\n' "$t"; else printf '  MISSING  %s\n' "$t"; missing=1; fi
  done
  for t in uuidgen timeout; do
    command -v "$t" >/dev/null 2>&1 && printf '  ok       %s (optional)\n' "$t" || printf '  absent   %s (optional; a fallback is used)\n' "$t"
  done
  [ "$missing" = 0 ] || echo "  install the missing ones ($hint ...); claude: https://docs.claude.com/en/docs/claude-code"
  return "$missing"
}

doctor_sync() { # when sync is on, check that git can push to origin unattended (returns 1 if not)
  [ "${HQ_SYNC:-off}" = on ] || return 0
  local repo
  repo="$(git -C "$STATE" rev-parse --show-toplevel 2>/dev/null)" || { echo "  MISSING  state repo ($STATE is not inside a git repo; HQ_SYNC=on needs one: hq init --state-repo DIR)"; return 1; }
  if sync_check "$repo"; then echo "  ok       sync: git can reach and push to origin without a prompt"; else echo "  FAILED   sync: see above"; return 1; fi
}

ask_default() { # <question> <default>: read a line from the terminal (stderr carries the prompt so stdout is just the answer)
  local reply=""
  printf '%s [%s]: ' "$1" "$2" >&2; IFS= read -r reply || true
  printf '%s' "${reply:-$2}"
}

init_cmd() {
  local name=work team=CHANGEME workdir="" statedir="" staterepo="" remote="" username="" issue_example="" sync="" force=0 prompt=0 pdir workd
  while [ $# -gt 0 ]; do case "$1" in
    --name) name=$2; shift 2;; --team) team=$2; shift 2;; --workdir) workdir=$2; shift 2;;
    --state-dir) statedir=$2; shift 2;; --state-repo) staterepo=$2; shift 2;; --remote) remote=$2; shift 2;; --user-name) username=$2; shift 2;; --issue-example) issue_example=$2; shift 2;; --prompt) prompt=1; shift;; --sync) sync=$2; shift 2;; --force) force=1; shift;;
    -h|--help) cat <<'USAGE'
hq init [--name NAME] [--team KEY] [--user-name N] [--issue-example ID] [--prompt] [--workdir DIR] [--state-repo DIR [--remote URL] | --state-dir DIR] [--sync on|off] [--force]
  --name       profile name (default: work). Created locally at ~/.config/hq/profiles/NAME from profiles/_template
  --team       issue-tracker team key used in prompts (default: CHANGEME)
  --workdir    directory that holds your project repos and where the PM runs (default: the parent of this hq dir)
  --state-dir  where board/briefs/logs live (default: ~/.local/state/hq, outside the repo)
  --user-name  how the PM addresses you (default: first word of git user.name, else $USER)
  --issue-example  an issue id used as the example in prompts (default: <TEAM>-123)
  --prompt     ask for the user name and example issue id (default: asks when stdin is a terminal and a flag is missing,
               and only when a new profile is being created); without a terminal the defaults are used
  --state-repo DIR  keep profiles + state in a separate PRIVATE git repo at DIR (created if needed; profiles in DIR/profiles,
               state in DIR/state/<hostname>); sync is on once it has an origin. Add the origin with --remote URL.
  --sync       on|off: whether bin/sync pushes the state repo to its origin (default: on if --state-repo has an origin, else off)
  --force      overwrite an existing local profile / env
USAGE
      exit 0;;
    *) echo "hq init: unknown option $1 (try --help)" >&2; exit 2;; esac; done
  echo "Checking requirements:"; doctor_cmd || { echo "hq init: install the missing requirements first" >&2; exit 1; }
  workd="${workdir:-$HOME_DIR}"
  if [ "$(cd "$workd" 2>/dev/null && pwd -P)" = "$(cd "$HOME" && pwd -P)" ]; then
    echo "hq init: workdir would be \$HOME (it would overwrite your global ~/.claude). Clone hq into a dedicated directory, e.g. ~/work/hq, or pass --workdir DIR." >&2; exit 1
  fi
  [ -d "$workd" ] || { echo "hq init: workdir '$workd' does not exist" >&2; exit 1; }
  # Values that end up in profile.env (sourced by bash): validate before anything is created, then ask for what the flags left out.
  valid_issue "$team" || { echo "hq init: invalid --team '$team' (letters, digits, . _ - only)" >&2; exit 2; }
  local dflt_user dflt_issue probe="$HQ_CONF/profiles/$name"
  [ -z "$staterepo" ] || probe="$staterepo/profiles/$name"
  dflt_user="$(git config user.name 2>/dev/null | awk '{print $1}')"; [ -n "$dflt_user" ] || dflt_user="${USER:-CHANGEME}"
  dflt_issue="$team-123"
  if { [ "$prompt" = 1 ] || [ -t 0 ]; } && { [ "$force" = 1 ] || [ ! -d "$probe" ]; }; then
    [ -n "$username" ] || username="$(ask_default "What should the PM call you?" "$dflt_user")"
    [ -n "$issue_example" ] || issue_example="$(ask_default "An example issue id (used in the PM's prompts)" "$dflt_issue")"
  fi
  [ -n "$username" ] || username=$dflt_user
  [ -n "$issue_example" ] || issue_example=$dflt_issue
  valid_name "$username" || { echo "hq init: invalid --user-name (no quotes, \$, backticks, |, &, ;, brackets or control characters; max 40)" >&2; exit 2; }
  valid_issue "$issue_example" || { echo "hq init: invalid --issue-example '$issue_example' (letters, digits, . _ - only)" >&2; exit 2; }
  local profdir="$HQ_CONF/profiles"
  if [ -n "$staterepo" ]; then
    mkdir -p "$staterepo"; staterepo="$(cd "$staterepo" && pwd -P)"
    case "$staterepo/" in "$HQ_DIR"/*) echo "hq init: --state-repo must be outside the hq app repo ($HQ_DIR)" >&2; exit 1;; esac
    [ -d "$staterepo/.git" ] || { git init -q -b main "$staterepo" 2>/dev/null || git init -q "$staterepo"; }
    [ -z "$remote" ] || git -C "$staterepo" remote get-url origin >/dev/null 2>&1 || { [ -z "$remote" ] || git -C "$staterepo" remote add origin "$remote"; }
    [ -f "$staterepo/README.md" ] || printf '# hq state (private)\n\nBoard, briefs, logs and profiles for hq. Contains tracker ids and environment details: keep this repo private.\n' > "$staterepo/README.md"
    profdir="$staterepo/profiles"; statedir="$staterepo/state/$HQ_HOST"
    [ -n "$sync" ] || { git -C "$staterepo" remote get-url origin >/dev/null 2>&1 && sync=on || sync=off; }
  fi
  [ -n "$sync" ] || sync=off
  if [ -n "$staterepo" ] && [ -n "$remote" ] && [ "$sync" = on ]; then   # warn early: the first sync would otherwise fail with a bare exit 2
    sync_check "$staterepo" || echo "hq init: continuing, but fix the above before relying on sync (check again with: hq doctor)" >&2
  fi
  mkdir -p "$HQ_CONF" "$profdir"; pdir="$profdir/$name"
  if [ -d "$pdir" ] && [ "$force" = 0 ]; then echo "keeping existing profile $pdir (--force to recreate)"
  else rm -rf "$pdir"; cp -R "$HQ_DIR/profiles/_template" "$pdir"; sed -e "s|^TEAM=.*|TEAM=$team|" -e "s|^USER_NAME=[^#]*|USER_NAME='$username'      |" -e "s|^ISSUE_EXAMPLE=.*|ISSUE_EXAMPLE=$issue_example|" "$pdir/profile.env" > "$pdir/profile.env.tmp" && mv "$pdir/profile.env.tmp" "$pdir/profile.env"; echo "created profile $pdir"; fi
  if [ -f "$HQ_CONF/env" ] && [ "$force" = 0 ]; then echo "keeping existing $HQ_CONF/env (--force to rewrite)"
  else
    { echo "HQ_PROFILE=$name"
      [ -n "$workdir" ] && echo "HQ_WORKDIR=$workdir"
      [ -z "$staterepo" ] || echo "HQ_PROFILES_DIR=$profdir"
      echo "HQ_STATE_DIR=${statedir:-${XDG_STATE_HOME:-$HOME/.local/state}/hq}"
      echo "HQ_SYNC=$sync"; } > "$HQ_CONF/env"; echo "wrote $HQ_CONF/env"
  fi
  mkdir -p "$HOME/.local/bin"; ln -sfn "$HQ_DIR/bin/hq" "$HOME/.local/bin/hq"
  case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) echo "note: add \$HOME/.local/bin to your PATH to run plain 'hq'";; esac
  "$HQ_DIR/bin/hq" config
  cat <<NEXT

Next:
  1. Edit $pdir/pm-profile.md and worker-extra.md (replace every CHANGEME: tracker, risky systems, PR flow, repo map)
  2. hq config     # re-render after editing
  3. hq            # start the PM; then tell it what to work on
NEXT
}

xmlq() { printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }

# launchd starts agents with a minimal environment, so the plist carries a fixed PATH instead of whatever PATH `hq autostart on`
# happened to run under. Extra directories go in ~/.config/hq/env (PATH="$PATH:/some/dir"), which every hq command sources.
LAUNCHD_PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
LAUNCHD_LOG="$HOME/Library/Logs/hq/autostart.log"   # outside the state repo, which sync would commit
launchd_plist() {
  cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>net.hq.up</string>
<key>ProgramArguments</key><array><string>$(xmlq "$HQ_DIR")/bin/hq</string><string>up</string></array>
<key>EnvironmentVariables</key><dict><key>PATH</key><string>$(xmlq "$LAUNCHD_PATH")</string></dict>
<key>RunAtLoad</key><true/>
<key>StandardOutPath</key><string>$(xmlq "$LAUNCHD_LOG")</string>
<key>StandardErrorPath</key><string>$(xmlq "$LAUNCHD_LOG")</string>
</dict></plist>
PLIST
}
# Warn (stderr) about required tools that the launchd PATH plus ~/.config/hq/env would not find at login.
autostart_path_check() {
  local t missing=0 where
  for t in tmux git python3 claude; do
    if ! ( PATH="$LAUNCHD_PATH"; [ ! -f "$HQ_CONF/env" ] || . "$HQ_CONF/env"; command -v "$t" >/dev/null 2>&1 ); then
      missing=1; where="$(command -v "$t" 2>/dev/null || true)"
      echo "autostart: '$t' is not on the PATH launchd will use at login${where:+ (it is at $where)}" >&2
      [ -z "$where" ] || echo "           add it: echo 'PATH=\"\$PATH:$(dirname "$where")\"' >> $HQ_CONF/env" >&2
    fi
  done
  return "$missing"
}
require_row() { # <issue> -> sets repo cwd uuid status
  need_issue "$1"; local row; row="$(board_row "$1")"
  [ -n "$row" ] || { echo "hq: no board row with exact id '$1'. Try: hq find <term>" >&2; exit 3; }
  IFS=$'\t' read -r _ repo cwd uuid status _ <<< "$row"
}

case "${1:-up}" in init|doctor) ;; *) need_profile ;; esac
case "${1:-up}" in
  init) shift; init_cmd "$@" ;;
  doctor) echo "hq requirements:"; rc=0; doctor_cmd || rc=1; doctor_sync || rc=1; exit "$rc" ;;
  config) gen_config; echo "generated $HOME_DIR/.claude (profile: $PROFILE from $PROFILE_DIR, state: $STATE)" ;;
  up) up; if [ -t 1 ] && [ -z "${TMUX:-}" ] && [ -z "${HQ_SOCKET:-}" ]; then exec tmux attach -t "$SESSION"; fi ;;
  status)
    echo "== board =="; [ -s "$BOARD" ] && column -t -s$'\t' "$BOARD" || echo "(empty)"
    echo; echo "== tmux =="; tm list-windows -t "$SESSION" 2>/dev/null || echo "(no session)" ;;
  down) tm kill-session -t "$SESSION" 2>/dev/null && echo "hq: down" || echo "hq: not running" ;;
  park)
    [ $# -eq 2 ] || { echo "usage: hq park <ISSUE>" >&2; exit 2; }
    require_row "$2"; [ "$status" != "done" ] || { echo "$2 is done, not parked" >&2; exit 1; }
    tm kill-window -t "$SESSION:$2" 2>/dev/null || true; board_set "$2" parked; echo "parked $2" ;;
  revive)
    [ $# -eq 2 ] || { echo "usage: hq revive <ISSUE>   (exact id; use 'hq find' for fuzzy)" >&2; exit 2; }
    require_row "$2"
    if has_window "$2"; then echo "$2 already live in tmux $SESSION:$2"; board_set "$2" active; exit 0; fi
    if [ "$repo" != "-" ] && [ ! -d "$cwd" ]; then
      make_worktree "$HOME_DIR/$repo" "$cwd" "$(printf '%s' "$2" | tr 'A-Z' 'a-z')"
      echo "hq: recreated worktree $cwd"
    fi
    start_worker "$2" "$repo" "$cwd" "$uuid"; board_set "$2" active
    if transcript_exists "$cwd" "$uuid"; then echo "revived $2 (conversation resumed)"; else echo "revived $2 (NO saved conversation; fresh session re-briefed)"; fi ;;
  find)
    [ $# -ge 2 ] || { echo "usage: hq find <term>" >&2; exit 2; }
    shift; python3 -I - "$BOARD" "$BRIEFS" "$PROJ_DIR" "$*" <<'PY'
import glob, json, os, sys, time
board, briefs, proj, term = sys.argv[1:5]
t = term.lower()
onboard = {}
print("== board / briefs ==")
if os.path.exists(board):
    for line in open(board):
        c = line.rstrip("\n").split("\t")
        if len(c) < 5: continue
        onboard[c[3]] = c[0]
        bf = os.path.join(briefs, c[0] + ".md")
        btxt = open(bf).read().lower() if os.path.exists(bf) else ""
        if t in line.lower() or t in btxt:
            print(f"{c[0]}\t{c[4]}\trepo={c[1]}\t{c[3]}")
print("== transcripts (newest first, max 12) ==")
files = sorted(glob.glob(os.path.join(proj, "*", "*.jsonl")), key=os.path.getmtime, reverse=True)[:300]
shown = 0
for f in files:
    try: txt = open(f, errors="replace").read()
    except OSError: continue
    n = txt.lower().count(t)
    if not n: continue
    cwd = first = None
    for line in txt.splitlines():
        try: o = json.loads(line)
        except ValueError: continue
        cwd = cwd or o.get("cwd")
        if first is None and o.get("type") == "user":
            m = o.get("message", {}).get("content")
            if isinstance(m, list): m = " ".join(p.get("text", "") for p in m if isinstance(p, dict))
            if isinstance(m, str) and m.strip() and not m.startswith("<"): first = " ".join(m.split())[:90]
        if cwd and first: break
    u = os.path.basename(f)[:-6]
    print(f"{u}\t{time.strftime('%Y-%m-%d', time.localtime(os.path.getmtime(f)))}\t{cwd}\thits={n}\t{'ON-BOARD:'+onboard[u] if u in onboard else 'not-on-board'}\t\"{first}\"")
    shown += 1
    if shown >= 12: break
if not shown: print("(none)")
PY
    ;;
  adopt)
    [ $# -ge 3 ] || { echo "usage: hq adopt <uuid> <ISSUE> [cwd]" >&2; exit 2; }
    uuid=$2 issue=$3 cwd=${4:-}; need_issue "$issue"
    case "$uuid" in *[!0-9a-fA-F-]*|"") echo "hq: invalid session id" >&2; exit 2;; esac
    [ -z "$(board_row "$issue")" ] || { echo "$issue already on board" >&2; exit 1; }
    f="$(ls "$PROJ_DIR"/*/"$uuid".jsonl 2>/dev/null | head -1)"; [ -n "$f" ] || { echo "no transcript for $uuid" >&2; exit 1; }
    # first and last cwd in the transcript: it is stored under the FIRST (where the session started), so that is what the board keeps
    IFS=$'\t' read -r first_cwd last_cwd <<< "$(python3 -I -c "
import json,sys
first = last = ''
for l in open(sys.argv[1]):
    try: c = json.loads(l).get('cwd')
    except ValueError: continue
    if c:
        first = first or c; last = c
print(first + '\t' + last)" "$f")"
    [ -n "$cwd" ] || cwd="$first_cwd"
    [ -d "$cwd" ] || { echo "cwd '$cwd' does not exist; pass one explicitly" >&2; exit 1; }
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$issue" - "$cwd" "$uuid" parked "$(now)" >> "$BOARD"
    echo "adopted $uuid as $issue (parked, cwd $cwd). Next: hq revive $issue"
    if [ -n "$last_cwd" ] && [ "$last_cwd" != "$first_cwd" ]; then
      echo "hq: warning: this session started in $first_cwd but later moved to $last_cwd (a worktree?)." >&2
      echo "    It will resume in $cwd, because its transcript is found by that directory. After 'hq revive $issue', tell the worker to cd to $last_cwd." >&2
    fi ;;
  autostart)
    act="${2:-status}"
    if [ "$act" = show ]; then   # print what `on` would install (no side effects); target defaults to this OS
      tgt="${3:-}"; [ -n "$tgt" ] || case "$(uname)" in Darwin) tgt=launchd;; *) tgt=systemd;; esac
      case "$tgt" in
        launchd) launchd_plist; autostart_path_check || true ;;
        systemd) sed -e "s|@HQ_DIR@|$HQ_DIR|g" -e "s|@PATH@|$PATH|g" "$HQ_DIR/systemd/hq.service" ;;
        *) echo "usage: hq autostart show [launchd|systemd]" >&2; exit 2 ;;
      esac
      exit 0
    fi
    case "$(uname)" in
      Linux)
        unit="$HOME/.config/systemd/user/hq.service"
        case "$act" in
          on)  command -v systemctl >/dev/null 2>&1 || { echo "autostart needs systemd" >&2; exit 1; }
               mkdir -p "$(dirname "$unit")"; rm -f "$unit"     # rm first: older installs symlinked into the repo
               sed -e "s|@HQ_DIR@|$HQ_DIR|g" -e "s|@PATH@|$PATH|g" "$HQ_DIR/systemd/hq.service" > "$unit"
               systemctl --user daemon-reload && systemctl --user enable hq.service
               echo "autostart on: 'hq up' runs whenever this user's systemd starts (WSL: when the distro starts)" ;;
          off) systemctl --user disable hq.service 2>/dev/null || true; rm -f "$unit"; systemctl --user daemon-reload 2>/dev/null || true; echo "autostart off" ;;
          status) systemctl --user is-enabled hq.service 2>&1 | head -1 || true ;;
          *) echo "usage: hq autostart on|off|status|show" >&2; exit 2 ;;
        esac ;;
      Darwin)   # launchd; not yet tested on a real Mac (see README)
        plist="$HOME/Library/LaunchAgents/net.hq.up.plist"
        case "$act" in
          on)  mkdir -p "$(dirname "$plist")" "$(dirname "$LAUNCHD_LOG")"
               launchd_plist > "$plist"
               autostart_path_check || echo "autostart: continuing; fix the PATH as shown or hq will not start at login" >&2
               launchctl load -w "$plist" && echo "autostart on (launchd)" ;;
          off) launchctl unload "$plist" 2>/dev/null || true; rm -f "$plist"; echo "autostart off" ;;
          status) [ -f "$plist" ] && echo enabled || echo disabled ;;
          *) echo "usage: hq autostart on|off|status|show" >&2; exit 2 ;;
        esac ;;
      *) echo "autostart: unsupported OS $(uname)" >&2; exit 1 ;;
    esac ;;
  *) echo "usage: hq [up|init|doctor|config|status|down|park|revive|find|adopt|autostart]" >&2; exit 2 ;;
esac
